# ============================================================
# Environment Variables for Railway Deployment
# ============================================================
# Copy these into your Railway service's "Variables" tab.
# NEVER commit real values to git — .env is in .gitignore.
# ============================================================

# --- Supabase (Auth + Database) ---
# Required on Railway. Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=your-supabase-project-url
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # SECRET — never expose publicly

# --- Supabase (Client bundle — must have VITE_ prefix to reach the browser) ---
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key

# --- Gemini AI ---
# Required for the AI chat feature. Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key                         # SECRET
# Optional — defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# --- Webhook (optional) ---
# Set a strong random string to verify channel callback webhook signatures.
# If left unset, any caller can post to /api/public/channel-callback.
# CHANNEL_WEBHOOK_SECRET=your-random-secret-string

# --- Build / Runtime (auto-managed — do NOT set these manually) ---
# NITRO_PRESET=node-server   <-- already set in railway.toml buildCommand
# NODE_ENV=production        <-- Railway sets this automatically
# PORT                       <-- Railway injects this automatically — do NOT set it
